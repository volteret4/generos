# Copia este fichero a .env.

# Carpeta de tu música en el anfitrión. Se monta con permiso de escritura:
# «Escribir» cambia la etiqueta GENRE de los ficheros (nunca otra).
MUSICA=/ruta/a/tu/musica

# Bibliotecas que ve la web, «nombre=ruta_en_el_contenedor=ruta_en_el_anfitrión;…».
# Con una sola carpeta basta lo de abajo; para varias, añade volúmenes en docker-compose.yml.
GENEROS_ROOTS=musica=/music=/music

# Opcional: raíces de canciones sueltas (una canción por item; sus subcarpetas se proponen como género)
GENEROS_PISTAS=
# Opcional: «raíz/subcarpeta,…» de canciones sueltas dentro de una raíz de discos
GENEROS_SUELTAS=
# Opcional: raíces que aquí solo se leen; lo guardado espera en /api/mix/pendientes
GENEROS_DIFERIDAS=

# Fuentes de propuestas (opcionales)
LASTFM_API_KEY=
DISCOGS_TOKEN=

# Opcional: AudioMuse-AI para el modo «Jugar» (discos parecidos por sonido)
AUDIOMUSE_URL=
AUDIOMUSE_TOKEN=
AUDIOMUSE_SERVERS=

# Uid:gid con permiso de escritura en tu música
UID_GID=1000:1000
PUERTO=8785
